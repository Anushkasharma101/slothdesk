MONGODB_URI=mongodb://127.0.0.1:27017/slothdesk_public
PORT=4100
NODE_ENV=development
# Public production URL: exact origin, no trailing slash. Local dev uses Vite:
APP_ORIGIN=http://localhost:5173
# Absolute path to private upload storage. Default: server/storage
STORAGE_DIR=
# On Render set 1; direct local access stays 0. Never use unrestricted true.
TRUST_PROXY=0
# Optional DNS override. Leave blank unless your Node DNS requires it.
DNS_SERVERS=
# Optional Ollama running on the backend's network, never the visitor's laptop:
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=
